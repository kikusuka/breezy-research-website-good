{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breezy-api",
  "main": "workers/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "breezy-chat-prod",
      "database_id": "9c35d9e4-47b7-451b-8266-eb90163c9883",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Keep production origins in deployment secrets/vars; only local development origins are committed.
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:5173",
    "FIREBASE_PROJECT_ID": "gen-lang-client-0059241208"
  }
}
